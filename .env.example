# Get an API key from https://aistudio.google.com/app/apikey
API_KEY=your_gemini_api_key_here

# Optional local overrides can go in a gitignored .env.local file.

# Optional yt-dlp settings. Leave YTDLP_EXECUTABLE blank to auto-detect yt-dlp.
# Windows example: C:\path\to\yt-dlp.exe
# Linux/macOS example: /usr/local/bin/yt-dlp
YTDLP_EXECUTABLE=

# Required only when YouTube needs an authenticated browser session.
YTDLP_COOKIES_FILE=

# Example: deno. Leave blank when no JavaScript runtime is needed.
YTDLP_JS_RUNTIMES=
# Leave blank to use the app's bandwidth-aware format selection.
YTDLP_FORMAT=
YTDLP_OUTPUT_TEMPLATE=%(id)s.%(ext)s

# Optional JSON array for additional yt-dlp flags.
YTDLP_EXTRA_ARGS=[]
YTDLP_CONFIG_LOCATION=
